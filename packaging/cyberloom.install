post_install() {
  cat <<'MSG'
==> Cyberloom is installed. To make the first run work rather than open, run
    once as your own user (not root):

        cyberloom-provision

    It starts Ollama and pulls the default model, makes the Python environment
    the perception helper runs in, and fetches the weights the example graphs
    use. The application's settings screen says what is still missing.
MSG
}

post_upgrade() {
  post_install
}
