# Maintainer: Mykl <mykl.b@hotmail.com>
#
# Arch and CachyOS. The engine and the host are one Rust workspace, so this is
# one `cargo build` and one `npm run build`, not a chain of them.
pkgname=cyberloom
pkgver=0.1.0
pkgrel=1
pkgdesc="Node-based visual programming for local AI: typed blocks on a canvas"
arch=('x86_64')
url="https://github.com/myklb-hue/super-waffle"
license=('MIT')

# webkit2gtk is the window. ffmpeg is what Webcam, Microphone and Speaker use.
# Python runs the perception helper and custom Python blocks; Ollama runs the
# models. All hard dependencies: the application is meant to run the first
# time it opens, and a dependency it might lack is a first run that does not.
# `ollama` here is the CPU build; a machine with a GPU wants ollama-cuda or
# ollama-rocm in its place, which provide the same `ollama`.
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'ffmpeg' 'python' 'ollama' 'curl')
install=cyberloom.install
makedepends=('rust' 'cargo' 'nodejs' 'npm' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/super-waffle-$pkgver"
  npm ci
  npm run build
  # `custom-protocol` is what makes this a release build in Tauri's eyes;
  # without it the window looks for a dev server that is not there.
  cargo build --release --bin cyberloom --features custom-protocol
}

check() {
  cd "$srcdir/super-waffle-$pkgver"
  cargo test --release --workspace
  npm test
}

package() {
  cd "$srcdir/super-waffle-$pkgver"
  install -Dm755 target/release/cyberloom "$pkgdir/usr/bin/cyberloom"

  # Rigs are content, not code (SPEC §11.1), and the engine looks for them
  # beside the binary before it looks anywhere else.
  install -d "$pkgdir/usr/share/cyberloom/rigs"
  cp -r rigs/* "$pkgdir/usr/share/cyberloom/rigs/"

  install -Dm644 packaging/cyberloom.desktop \
    "$pkgdir/usr/share/applications/cyberloom.desktop"
  install -Dm644 apps/desktop/src-tauri/icons/icon.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/cyberloom.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # What a first run needs beyond the binary is downloaded, not packaged: the
  # provisioning script does it, per user, on demand. The helper it installs
  # ships beside it.
  install -Dm755 scripts/provision.sh "$pkgdir/usr/bin/cyberloom-provision"
  install -Dm644 crates/loomd/py/perceive.py "$pkgdir/usr/lib/cyberloom/py/perceive.py"
  install -Dm644 crates/loomd/py/requirements.txt "$pkgdir/usr/lib/cyberloom/py/requirements.txt"

  # The example graphs, for a first run that has something to look at.
  install -d "$pkgdir/usr/share/cyberloom/graphs"
  install -Dm644 fixtures/graphs/*.loom "$pkgdir/usr/share/cyberloom/graphs/"
}
